# Copie para .env e preencha. NUNCA versione o arquivo .env.
NODE_ENV=development
PORT=3000

# Chave mestra (32 bytes em base64). Gere com: npm run gerar-chave
# Sem ela o app roda com chave temporária e dados SOMENTE em memória.
APP_MASTER_KEY=

# Senha dos usuários de demonstração (se vazio, é gerada e exibida no console)
DEMO_PASSWORD=

# Dados legais da farmácia (exibidos no app — exigência da RDC 44/2009)
FARMACIA_NOME=Farmácia Exemplo
FARMACIA_CNPJ=00.000.000/0001-00
FARMACIA_AFE=0.00000-0
FARMACIA_RT_NOME=Farmacêutico Responsável
FARMACIA_RT_CRF=CRF-SP 00000

# Pagamentos (gateway). mock = simulado
PAGAMENTO_MODO=mock
PAGAMENTO_WEBHOOK_SECRET=

# iFood Merchant API. mock = simulado, live = API real
IFOOD_MODO=mock
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_ID=

# WhatsApp Cloud API (Meta). mock = simulado, live = API real
WHATSAPP_MODO=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
