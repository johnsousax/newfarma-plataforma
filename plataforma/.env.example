# Copie para .env e preencha. NUNCA versione o .env.
# Banco PostgreSQL. Em desenvolvimento, "npm run db" sobe um Postgres local nessa URL.
DATABASE_URL="postgresql://farmacia:troque-esta-senha@localhost:54329/farmacia"

# Chave mestra (32 bytes base64) para cifrar CPF, receitas e conversas. Gere com: npm run gerar-chave
APP_MASTER_KEY=""

# Senha dos usuários de demonstração criados pelo seed
DEMO_PASSWORD=""

# ── Dados da farmácia (aparecem no site; RDC 44/2009 exige CNPJ, AFE e RT/CRF visíveis)
NEXT_PUBLIC_FARMACIA_NOME="New Farma Popular"
NEXT_PUBLIC_SITE_URL="https://www.newpopularfarma.com.br"
FARMACIA_RAZAO_SOCIAL="LUANA S DOS SANTOS LTDA"
FARMACIA_CNPJ="49.500.230/0001-09"
FARMACIA_AFE=""                         # nº da Autorização de Funcionamento (ANVISA) — PREENCHER
FARMACIA_RT_NOME=""                     # farmacêutico(a) responsável técnico — PREENCHER
FARMACIA_RT_CRF=""                      # ex.: CRF-SP 12345 — PREENCHER
NEXT_PUBLIC_FARMACIA_WHATSAPP=""        # só dígitos com DDI, ex.: 5511999990000
NEXT_PUBLIC_FARMACIA_TELEFONE=""
NEXT_PUBLIC_FARMACIA_EMAIL=""
NEXT_PUBLIC_MAX_PARCELAS="3"

# ── Assistente virtual (Claude). Sem chave, as dúvidas vão direto para o farmacêutico.
ANTHROPIC_API_KEY=""
# ASSISTENTE_MODELO="claude-opus-5-5"

# ── E-mail transacional (recuperação de senha). Sem chave, o link sai no console do servidor.
RESEND_API_KEY=""
EMAIL_REMETENTE="New Farma Popular <nao-responda@newpopularfarma.com.br>"
