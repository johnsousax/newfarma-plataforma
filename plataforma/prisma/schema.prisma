// Modelo de dados da plataforma Farmácia (PostgreSQL).
// Valores monetários em CENTAVOS (Int) para evitar erro de arredondamento.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Papel {
  CLIENTE
  ATENDENTE
  FARMACEUTICO
  GERENTE
  ADMIN
}

enum Classificacao {
  NAO_MEDICAMENTO
  MIP
  TARJA_VERMELHA
  ANTIMICROBIANO
  CONTROLADO
}

enum TipoMedicamento {
  NAO_SE_APLICA
  REFERENCIA
  GENERICO
  SIMILAR
}

enum StatusPedido {
  AGUARDANDO_RECEITA
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_SEPARACAO
  PRONTO_PARA_RETIRADA
  SAIU_PARA_ENTREGA
  ENTREGUE
  CANCELADO
}

enum Modalidade {
  ENTREGA_PADRAO
  ENTREGA_EXPRESSA
  RETIRADA
  BALCAO
}

enum Canal {
  SITE
  PDV
  IFOOD
  WHATSAPP
}

enum MetodoPagamento {
  CARTAO_CREDITO
  CARTAO_DEBITO
  PIX
  DINHEIRO
  /// Fiado: lançado na conta de crediário do cliente (só no balcão)
  CREDIARIO
  /// Compra pelo convênio da empresa do cliente (só no balcão)
  CONVENIO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  EXPIRADO
  ESTORNADO
}

enum StatusReceita {
  PENDENTE
  APROVADA
  REJEITADA
}

enum StatusModeracao {
  PENDENTE
  APROVADA
  /// Guardada pelo dono: fica no painel, não aparece no site
  GUARDADA
  REJEITADA
}

enum TipoCupom {
  PERCENTUAL
  VALOR_FIXO
  FRETE_GRATIS
}

enum TipoPromocao {
  PERCENTUAL
  LEVE_PAGUE
}

enum TipoMovimento {
  ENTRADA
  SAIDA_VENDA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  PERDA
  RESERVA
  LIBERACAO
}

enum StatusCompra {
  RASCUNHO
  ENVIADO
  RECEBIDO
  CANCELADO
}

enum StatusCaixa {
  ABERTO
  FECHADO
}

enum TipoMovCaixa {
  SUPRIMENTO
  SANGRIA
  VENDA
}

// ─────────────────────────────── Lojas e pessoas ───────────────────────────────

model Loja {
  id                 String   @id @default(uuid())
  nome               String
  slug               String   @unique
  cnpj               String
  telefone           String
  cep                String
  logradouro         String
  numero             String
  bairro             String
  cidade             String
  uf                 String
  horario            String
  /// Faixas de CEP atendidas com entrega local, ex.: ["01000-03999", "04000-04999"]
  faixasCep          String[]
  aceitaExpressa     Boolean  @default(true)
  /// Centro de distribuição: atende entregas padrão para todo o Brasil
  centroDistribuicao Boolean  @default(false)
  ativa              Boolean  @default(true)
  latitude           Float?
  longitude          Float?
  criadoEm           DateTime @default(now())
  zonas              ZonaEntrega[]

  equipe   Usuario[]
  lotes    Lote[]
  pedidos  Pedido[]
  compras  PedidoCompra[]
  caixas   CaixaSessao[]
  movimentos MovimentoEstoque[]
}

model Usuario {
  id               String    @id @default(uuid())
  nome             String
  email            String    @unique
  senhaHash        String
  /// CPF cifrado (AES-256-GCM) + hash para busca/unicidade sem expor o dado
  cpfCifrado       String?
  cpfHash          String?   @unique
  telefone         String?
  nascimento       DateTime?
  papel            Papel     @default(CLIENTE)
  lojaId           String?
  loja             Loja?     @relation(fields: [lojaId], references: [id])
  crf              String?
  pontos           Int       @default(0)
  consentimentoLgpdEm DateTime?
  /// Consentimento específico para o assistente tratar dados de saúde (LGPD art. 11)
  consentimentoAssistenteEm DateTime?
  aceitaMarketing  Boolean   @default(false)
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?
  ativo            Boolean   @default(true)
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt

  /// Hash do telefone para localizar o cliente pelo WhatsApp
  telefoneHash     String?
  /// Segundo fator (TOTP, app autenticador)
  totpSegredoCifrado String?
  totpAtivoEm      DateTime?
  totpUltimoPasso  Int?
  codigosRecuperacao String[] @default([])
  /// Comissão sobre as vendas em pontos-base (150 = 1,5%)
  comissaoBp       Int       @default(0)

  sessoes      Sessao[]
  enderecos    Endereco[]
  pedidos      Pedido[]      @relation("PedidosCliente")
  favoritos    Favorito[]
  avaliacoes   Avaliacao[]
  carrinho     Carrinho?
  assinaturas  Assinatura[]
  lembretes    Lembrete[]
  movPontos    MovimentoPontos[]
  receitas     Receita[]     @relation("ReceitasCliente")
  receitasAvaliadas Receita[] @relation("ReceitasFarmaceutico")
  caixas       CaixaSessao[]
  tokensSenha  TokenSenha[]
  conversas    Conversa[]    @relation("ConversasCliente")
  conversasAtendidas Conversa[] @relation("ConversasFarmaceutico")

  @@index([papel])
  @@index([telefoneHash])
}

model Sessao {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  ip        String?
  userAgent String?
  criadoEm  DateTime @default(now())
  /// Login feito, falta o código do app autenticador
  mfaPendente     Boolean   @default(false)
  tentativasMfa   Int       @default(0)
  /// Última confirmação do 2º fator (libera ações críticas por alguns minutos)
  reautenticadoEm DateTime?
  ultimoUsoEm     DateTime  @default(now())

  @@index([usuarioId])
}

/// Limite de tentativas compartilhado entre instâncias do servidor
model LimiteTaxa {
  chave    String   @id
  contagem Int
  expiraEm DateTime

  @@index([expiraEm])
}

model Endereco {
  id           String   @id @default(uuid())
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  apelido      String
  destinatario String
  cep          String
  logradouro   String
  numero       String
  complemento  String?
  bairro       String
  cidade       String
  uf           String
  principal    Boolean  @default(false)
  criadoEm     DateTime @default(now())

  assinaturas Assinatura[]

  @@index([usuarioId])
}

// ─────────────────────────────── Catálogo ───────────────────────────────

model Categoria {
  id        String      @id @default(uuid())
  nome      String
  slug      String      @unique
  descricao String?
  icone     String
  cor       String      @default("#0f766e")
  ordem     Int         @default(0)
  paiId     String?
  pai       Categoria?  @relation("Hierarquia", fields: [paiId], references: [id])
  filhas    Categoria[] @relation("Hierarquia")
  produtos  Produto[]
  promocoes Promocao[]
}

model Marca {
  id         String     @id @default(uuid())
  nome       String
  slug       String     @unique
  fabricante String?
  produtos   Produto[]
  promocoes  Promocao[]
}

model Produto {
  id                 String          @id @default(uuid())
  sku                String          @unique
  ean                String?         @unique
  nome               String
  slug               String          @unique
  /// Texto normalizado (minúsculo, sem acento) para busca
  busca              String
  descricaoCurta     String
  descricao          String
  marcaId            String
  marca              Marca           @relation(fields: [marcaId], references: [id])
  categoriaId        String
  categoria          Categoria       @relation(fields: [categoriaId], references: [id])
  classificacao      Classificacao
  tipo               TipoMedicamento @default(NAO_SE_APLICA)
  principioAtivo     String?
  concentracao       String?
  formaFarmaceutica  String?
  apresentacao       String?
  registroAnvisa     String?
  indicacoes         String?
  contraindicacoes   String?
  modoDeUsar         String?
  advertencias       String?
  /// Preço de venda
  preco              Int
  /// Preço "de" (riscado) para comunicar desconto
  precoDe            Int?
  /// Preço Máximo ao Consumidor (CMED) — o preço de venda nunca pode superá-lo
  pmc                Int?
  /// Custo médio (para margem nos relatórios)
  custo              Int?
  icone              String          @default("💊")
  estoqueMinimo      Int             @default(10)
  pesoGramas         Int             @default(100)
  /// Dados fiscais (NF-e / NFC-e)
  ncm                String?
  cest               String?
  cfop               String?
  /// Origem da mercadoria (0 = nacional ... 8)
  origemFiscal       Int             @default(0)
  /// CSOSN (Simples) ou CST do ICMS
  cstIcms            String?
  unidade            String          @default("UN")
  ativo              Boolean         @default(true)
  destaque           Boolean         @default(false)
  /// Unidades vendidas (alimenta "mais vendidos")
  vendas             Int             @default(0)
  tags               String[]
  criadoEm           DateTime        @default(now())
  atualizadoEm       DateTime        @updatedAt

  lotes          Lote[]
  movimentos     MovimentoEstoque[]
  historicoPreco HistoricoPreco[]
  avaliacoes     Avaliacao[]
  favoritos      Favorito[]
  itensCarrinho  CarrinhoItem[]
  itensPedido    PedidoItem[]
  itensCompra    PedidoCompraItem[]
  assinaturas    Assinatura[]
  lembretes      Lembrete[]
  escrituracoes  Escrituracao[]
  promocoes      Promocao[]         @relation("PromocaoProdutos")
  imagens        ImagemProduto[]

  @@index([categoriaId])
  @@index([marcaId])
  @@index([principioAtivo])
  @@index([ativo, destaque])
  @@index([vendas])
}

model HistoricoPreco {
  id            String   @id @default(uuid())
  produtoId     String
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  precoAnterior Int
  precoNovo     Int
  usuarioId     String?
  motivo        String?
  criadoEm      DateTime @default(now())

  @@index([produtoId])
}

model Avaliacao {
  id               String          @id @default(uuid())
  produtoId        String
  produto          Produto         @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  usuarioId        String
  usuario          Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nota             Int
  titulo           String
  comentario       String
  status           StatusModeracao @default(PENDENTE)
  compraVerificada Boolean         @default(false)
  criadoEm         DateTime        @default(now())

  @@unique([produtoId, usuarioId])
  @@index([produtoId, status])
}

model Favorito {
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  produtoId String
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())

  @@id([usuarioId, produtoId])
}

// ─────────────────────────────── Marketing ───────────────────────────────

model Banner {
  id         String    @id @default(uuid())
  titulo     String
  subtitulo  String?
  textoBotao String    @default("Aproveitar")
  link       String
  corDe      String    @default("#0f766e")
  corPara    String    @default("#14b8a6")
  icone      String    @default("💊")
  /// Arte pronta: imagem enviada (1600x500) ou SVG criado pelo agente de design
  imagem     Bytes?
  imagemMime String?
  svg        String?
  ordem      Int       @default(0)
  ativo      Boolean   @default(true)
  inicio     DateTime?
  fim        DateTime?
  criadoEm   DateTime  @default(now())
}

model Promocao {
  id          String       @id @default(uuid())
  nome        String
  tipo        TipoPromocao
  /// PERCENTUAL: % de desconto
  percentual  Int?
  /// LEVE_PAGUE: leve N, pague M
  leve        Int?
  pague       Int?
  categoriaId String?
  categoria   Categoria?   @relation(fields: [categoriaId], references: [id])
  marcaId     String?
  marca       Marca?       @relation(fields: [marcaId], references: [id])
  produtos    Produto[]    @relation("PromocaoProdutos")
  inicio      DateTime
  fim         DateTime
  ativa       Boolean      @default(true)
  criadoEm    DateTime     @default(now())
}

model Cupom {
  id             String    @id @default(uuid())
  codigo         String    @unique
  descricao      String
  tipo           TipoCupom
  /// PERCENTUAL: 0-100 · VALOR_FIXO: centavos · FRETE_GRATIS: ignorado
  valor          Int       @default(0)
  minimoPedido   Int       @default(0)
  usoMaximo      Int?
  usoPorCliente  Int       @default(1)
  usos           Int       @default(0)
  primeiraCompra Boolean   @default(false)
  inicio         DateTime?
  fim            DateTime?
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now())

  pedidos Pedido[]
}

// ─────────────────────────────── Estoque ───────────────────────────────

model Lote {
  id         String   @id @default(uuid())
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id])
  lojaId     String
  loja       Loja     @relation(fields: [lojaId], references: [id])
  codigo     String
  validade   DateTime
  quantidade Int
  reservado  Int      @default(0)
  custoUnit  Int?
  criadoEm   DateTime @default(now())

  movimentos MovimentoEstoque[]

  @@unique([produtoId, lojaId, codigo])
  @@index([lojaId, produtoId])
  @@index([validade])
}

model MovimentoEstoque {
  id         String        @id @default(uuid())
  produtoId  String
  produto    Produto       @relation(fields: [produtoId], references: [id])
  lojaId     String
  loja       Loja          @relation(fields: [lojaId], references: [id])
  loteId     String?
  lote       Lote?         @relation(fields: [loteId], references: [id])
  tipo       TipoMovimento
  quantidade Int
  motivo     String?
  usuarioId  String?
  pedidoId   String?
  compraId   String?
  criadoEm   DateTime      @default(now())

  @@index([lojaId, criadoEm])
  @@index([produtoId])
}

// ─────────────────────────────── Carrinho e pedidos ───────────────────────────────

model Carrinho {
  id           String         @id @default(uuid())
  usuarioId    String?        @unique
  usuario      Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cupomCodigo  String?
  cep          String?
  atualizadoEm DateTime       @updatedAt
  criadoEm     DateTime       @default(now())
  itens        CarrinhoItem[]
}

model CarrinhoItem {
  id         String   @id @default(uuid())
  carrinhoId String
  carrinho   Carrinho @relation(fields: [carrinhoId], references: [id], onDelete: Cascade)
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  quantidade Int

  @@unique([carrinhoId, produtoId])
}

model Pedido {
  id                String           @id @default(uuid())
  numero            Int              @unique @default(autoincrement())
  usuarioId         String?
  usuario           Usuario?         @relation("PedidosCliente", fields: [usuarioId], references: [id])
  lojaId            String
  loja              Loja             @relation(fields: [lojaId], references: [id])
  canal             Canal            @default(SITE)
  status            StatusPedido
  modalidade        Modalidade
  /// Cópia do endereço no momento da compra
  enderecoEntrega   Json?
  subtotal          Int
  descontoPromocoes Int              @default(0)
  descontoCupom     Int              @default(0)
  descontoPontos    Int              @default(0)
  frete             Int              @default(0)
  total             Int
  cupomId           String?
  cupom             Cupom?           @relation(fields: [cupomId], references: [id])
  pontosUsados      Int              @default(0)
  pontosGanhos      Int              @default(0)
  metodoPagamento   MetodoPagamento?
  previsaoEntrega   DateTime?
  observacao        String?
  cpfNaNota         String?
  clienteNome       String?
  operadorId        String?
  caixaId           String?
  caixa             CaixaSessao?     @relation(fields: [caixaId], references: [id])
  assinaturaId      String?
  motoboyId         String?
  motoboy           Motoboy?         @relation(fields: [motoboyId], references: [id])
  despachadoEm      DateTime?
  entregueEm        DateTime?
  /// Valor repassado ao motoboy por esta entrega
  taxaMotoboy       Int?
  /// Vendedor que atendeu (comissão); no balcão, padrão = operador do caixa
  vendedorId        String?
  contaCrediarioId  String?
  convenioId        String?
  notas             NotaFiscal[]
  criadoEm          DateTime         @default(now())
  atualizadoEm      DateTime         @updatedAt

  itens         PedidoItem[]
  eventos       PedidoEvento[]
  pagamentos    Pagamento[]
  receitas      Receita[]
  escrituracoes Escrituracao[]

  @@index([usuarioId, criadoEm])
  @@index([status])
  @@index([lojaId, criadoEm])
  @@index([criadoEm])
}

model PedidoItem {
  id            String        @id @default(uuid())
  pedidoId      String
  pedido        Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto       @relation(fields: [produtoId], references: [id])
  nome          String
  sku           String
  classificacao Classificacao
  quantidade    Int
  precoUnitario Int
  desconto      Int           @default(0)
  total         Int
  custoUnitario Int?
  /// [{ loteId, codigo, validade, quantidade }]
  alocacoes     Json          @default("[]")
}

model PedidoEvento {
  id        String       @id @default(uuid())
  pedidoId  String
  pedido    Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  status    StatusPedido
  descricao String
  usuarioId String?
  criadoEm  DateTime     @default(now())

  @@index([pedidoId])
}

model Pagamento {
  id             String          @id @default(uuid())
  pedidoId       String
  pedido         Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  metodo         MetodoPagamento
  status         StatusPagamento
  valor          Int
  parcelas       Int             @default(1)
  gatewayId      String          @unique
  cartaoBandeira String?
  cartaoFinal    String?
  pixCopiaECola  String?
  pixExpiraEm    DateTime?
  valorRecebido  Int?
  troco          Int?
  motivoRecusa   String?
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt

  @@index([pedidoId])
  @@index([status, pixExpiraEm])
}

// ─────────────────────────────── ANVISA ───────────────────────────────

model Receita {
  id               String        @id @default(uuid())
  pedidoId         String
  pedido           Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuarioId        String
  usuario          Usuario       @relation("ReceitasCliente", fields: [usuarioId], references: [id])
  /// Arquivo cifrado com AES-256-GCM (dado sensível de saúde — LGPD art. 11)
  arquivoCifrado   Bytes
  mime             String
  tamanho          Int
  prescritorCifrado String
  registroPrescritor String
  dataEmissao      DateTime
  status           StatusReceita @default(PENDENTE)
  farmaceuticoId   String?
  farmaceutico     Usuario?      @relation("ReceitasFarmaceutico", fields: [farmaceuticoId], references: [id])
  observacao       String?
  avaliadoEm       DateTime?
  criadoEm         DateTime      @default(now())
  /// SHA-256 do arquivo (detecta a mesma receita reenviada)
  arquivoHash      String?

  escrituracoes Escrituracao[]

  @@index([status])
  @@index([pedidoId])
  @@index([arquivoHash])
}

/// Livro de escrituração (base para transmissão ao SNGPC)
model Escrituracao {
  id                 String   @id @default(uuid())
  pedidoId           String
  pedido             Pedido   @relation(fields: [pedidoId], references: [id])
  produtoId          String
  produto            Produto  @relation(fields: [produtoId], references: [id])
  lojaId             String
  registroAnvisa     String?
  principioAtivo     String?
  quantidade         Int
  lotes              Json
  receitaId          String?
  receita            Receita? @relation(fields: [receitaId], references: [id])
  registroPrescritor String?
  farmaceuticoId     String
  crfFarmaceutico    String
  transmitidoSngpc   Boolean  @default(false)
  criadoEm           DateTime @default(now())

  @@index([criadoEm])
}

// ─────────────────────────────── Conta do cliente ───────────────────────────────

model Assinatura {
  id                 String    @id @default(uuid())
  usuarioId          String
  usuario            Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  produtoId          String
  produto            Produto   @relation(fields: [produtoId], references: [id])
  enderecoId         String?
  endereco           Endereco? @relation(fields: [enderecoId], references: [id], onDelete: SetNull)
  quantidade         Int
  intervaloDias      Int
  descontoPercentual Int       @default(10)
  proximaEntrega     DateTime
  ativa              Boolean   @default(true)
  criadoEm           DateTime  @default(now())

  @@index([usuarioId])
  @@index([ativa, proximaEntrega])
}

model Lembrete {
  id              String    @id @default(uuid())
  usuarioId       String
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  produtoId       String?
  produto         Produto?  @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  nomeMedicamento String
  dosagem         String?
  /// Horários "HH:MM"
  horarios        String[]
  inicio          DateTime
  fim             DateTime?
  /// Quantidade de doses na embalagem — usada para avisar a hora de recomprar
  dosesRestantes  Int?
  ativo           Boolean   @default(true)
  criadoEm        DateTime  @default(now())

  @@index([usuarioId])
}

model MovimentoPontos {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pedidoId  String?
  pontos    Int
  descricao String
  expiraEm  DateTime?
  criadoEm  DateTime  @default(now())

  @@index([usuarioId, criadoEm])
}

// ─────────────────────────────── Compras ───────────────────────────────

model Fornecedor {
  id               String         @id @default(uuid())
  razaoSocial      String
  nomeFantasia     String
  cnpj             String         @unique
  email            String?
  telefone         String?
  contato          String?
  prazoEntregaDias Int            @default(5)
  ativo            Boolean        @default(true)
  criadoEm         DateTime       @default(now())
  compras          PedidoCompra[]
  lancamentos      Lancamento[]
}

model PedidoCompra {
  id           String             @id @default(uuid())
  numero       Int                @unique @default(autoincrement())
  fornecedorId String
  fornecedor   Fornecedor         @relation(fields: [fornecedorId], references: [id])
  lojaId       String
  loja         Loja               @relation(fields: [lojaId], references: [id])
  status       StatusCompra       @default(RASCUNHO)
  observacao   String?
  total        Int                @default(0)
  criadoPorId  String
  enviadoEm    DateTime?
  recebidoEm   DateTime?
  notaFiscal   String?
  criadoEm     DateTime           @default(now())
  itens        PedidoCompraItem[]

  @@index([status])
}

model PedidoCompraItem {
  id            String       @id @default(uuid())
  compraId      String
  compra        PedidoCompra @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto      @relation(fields: [produtoId], references: [id])
  quantidade    Int
  custoUnitario Int
}

// ─────────────────────────────── PDV / Caixa ───────────────────────────────

model CaixaSessao {
  id                 String          @id @default(uuid())
  lojaId             String
  loja               Loja            @relation(fields: [lojaId], references: [id])
  operadorId         String
  operador           Usuario         @relation(fields: [operadorId], references: [id])
  status             StatusCaixa     @default(ABERTO)
  valorAbertura      Int
  valorInformado     Int?
  valorEsperado      Int?
  diferenca          Int?
  abertoEm           DateTime        @default(now())
  fechadoEm          DateTime?
  movimentos         CaixaMovimento[]
  vendas             Pedido[]

  @@index([lojaId, status])
}

model CaixaMovimento {
  id        String           @id @default(uuid())
  caixaId   String
  caixa     CaixaSessao      @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  tipo      TipoMovCaixa
  metodo    MetodoPagamento?
  valor     Int
  descricao String
  pedidoId  String?
  criadoEm  DateTime         @default(now())
}

// ─────────────────────────────── Auditoria ───────────────────────────────

/// Trilha de auditoria encadeada por hash (detecta adulteração)
model Auditoria {
  seq          Int      @id @default(autoincrement())
  acao         String
  usuarioId    String?
  alvo         String?
  ip           String?
  detalhes     Json?
  hashAnterior String
  hash         String
  criadoEm     DateTime @default(now())

  @@index([acao])
  @@index([criadoEm])
}

// ─────────────────────────────── Recuperação de senha ───────────────────────────────

model TokenSenha {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@index([usuarioId])
}

// ─────────────────────────────── Fotos de produto ───────────────────────────────

model ImagemProduto {
  id        String   @id @default(uuid())
  produtoId String
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  mime      String
  dados     Bytes
  tamanho   Int
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now())

  @@index([produtoId, ordem])
}

// ─────────────────────────────── Assistente e atendimento ───────────────────────────────

enum StatusConversa {
  ASSISTENTE
  AGUARDANDO_FARMACEUTICO
  EM_ATENDIMENTO
  ENCERRADA
}

enum AutorMensagem {
  CLIENTE
  ASSISTENTE
  FARMACEUTICO
  SISTEMA
}

model Conversa {
  id             String         @id @default(uuid())
  usuarioId      String
  usuario        Usuario        @relation("ConversasCliente", fields: [usuarioId], references: [id], onDelete: Cascade)
  status         StatusConversa @default(ASSISTENTE)
  /// Título curto para o histórico (gerado da primeira pergunta)
  titulo         String?
  farmaceuticoId String?
  farmaceutico   Usuario?       @relation("ConversasFarmaceutico", fields: [farmaceuticoId], references: [id])
  /// Motivo do encaminhamento ao farmacêutico (ex.: interação, posologia, emergência)
  motivoEncaminhamento String?
  emergencia     Boolean        @default(false)
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt
  mensagens      Mensagem[]

  @@index([status, atualizadoEm])
  @@index([usuarioId, atualizadoEm])
}

model Mensagem {
  id         String        @id @default(uuid())
  conversaId String
  conversa   Conversa      @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autor      AutorMensagem
  autorId    String?
  /// Texto cifrado (AES-256-GCM): conversa sobre saúde é dado sensível
  textoCifrado String
  /// Resposta estruturada do assistente (medicamentos identificados etc.), cifrada
  dadosCifrados String?
  /// A imagem NÃO é guardada; só registramos que houve uma
  teveImagem Boolean       @default(false)
  bloqueadaPorRegra String?
  criadoEm   DateTime      @default(now())

  @@index([conversaId, criadoEm])
}

// ─────────────────────────────── Integrações (segredos configurados pelo painel) ───────────────────────────────

/// Credenciais de integrações (ex.: chave da Anthropic), sempre cifradas com APP_MASTER_KEY
model Integracao {
  chave         String   @id
  valorCifrado  String
  finalVisivel  String
  atualizadoPor String?
  atualizadoEm  DateTime @updatedAt
}

/// Configurações da loja editadas pelo dono no painel (valores não secretos)
model Configuracao {
  chave         String   @id
  valor         Json
  atualizadoPor String?
  atualizadoEm  DateTime @updatedAt
}

// ─────────────────────────────── Entregas ───────────────────────────────

/// Taxa e prazo de entrega por bairro
model ZonaEntrega {
  id           String   @id @default(uuid())
  lojaId       String
  loja         Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  bairro       String
  /// Nome normalizado (sem acento, minúsculo) para comparar com o endereço
  bairroBusca  String
  taxa         Int
  prazoMinutos Int      @default(60)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())

  @@unique([lojaId, bairroBusca])
}

model Motoboy {
  id             String    @id @default(uuid())
  nome           String
  telefone       String
  veiculo        String?
  placa          String?
  taxaPorEntrega Int       @default(0)
  ativo          Boolean   @default(true)
  /// Link exclusivo do app do entregador (não exige login)
  token          String    @unique
  tokenExpiraEm  DateTime?
  latitude       Float?
  longitude      Float?
  posicaoEm      DateTime?
  criadoEm       DateTime  @default(now())
  pedidos        Pedido[]
}

// ─────────────────────────────── Fiscal ───────────────────────────────

enum ModeloNota {
  NFCE
  NFE
}

enum StatusNota {
  /// Gerada e validada, aguardando transmissão (sem provedor configurado)
  PENDENTE
  ENVIADA
  AUTORIZADA
  REJEITADA
  CANCELADA
}

model NotaFiscal {
  id           String     @id @default(uuid())
  pedidoId     String
  pedido       Pedido     @relation(fields: [pedidoId], references: [id])
  modelo       ModeloNota @default(NFCE)
  serie        Int
  numero       Int
  ambiente     String
  status       StatusNota @default(PENDENTE)
  chaveAcesso  String     @unique
  protocolo    String?
  /// Documento pronto para o provedor (layout 4.00 em JSON)
  conteudo     Json
  xmlAutorizado String?
  motivo       String?
  valorTotal   Int
  provedor     String
  emitidaPor   String?
  autorizadaEm DateTime?
  canceladaEm  DateTime?
  criadoEm     DateTime   @default(now())

  @@unique([modelo, serie, numero, ambiente])
  @@index([pedidoId])
}

// ─────────────────────────────── WhatsApp da loja ───────────────────────────────

enum StatusMensagemWhats {
  ENVIANDO
  ENVIADA
  ENTREGUE
  LIDA
  ERRO
  RECEBIDA
}

model WhatsappConversa {
  id             String             @id @default(uuid())
  /// Número com DDI, só dígitos
  telefone       String             @unique
  nome           String?
  usuarioId      String?
  ultimaPrevia   String?
  ultimaEm       DateTime           @default(now())
  naoLidas       Int                @default(0)
  arquivada      Boolean            @default(false)
  criadoEm       DateTime           @default(now())
  mensagens      WhatsappMensagem[]

  @@index([ultimaEm])
}

model WhatsappMensagem {
  id          String              @id @default(uuid())
  conversaId  String
  conversa    WhatsappConversa    @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  externoId   String?             @unique
  deMim       Boolean
  /// texto | imagem | audio | video | documento | figurinha | outro
  tipo        String              @default("texto")
  /// Conteúdo cifrado (pode conter dados de saúde)
  textoCifrado String?
  midia       Bytes?
  midiaMime   String?
  arquivoNome String?
  status      StatusMensagemWhats @default(RECEBIDA)
  autorId     String?
  criadoEm    DateTime            @default(now())

  @@index([conversaId, criadoEm])
}

// ─────────────────────────────── Financeiro ───────────────────────────────

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum StatusLancamento {
  ABERTO
  PAGO
  CANCELADO
}

/// Caixa, banco ou carteira digital
model ContaFinanceira {
  id           String       @id @default(uuid())
  nome         String
  tipo         String       @default("BANCO")
  saldoInicial Int          @default(0)
  ativa        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  lancamentos  Lancamento[]
}

/// Plano de contas. `grupo` organiza a DRE.
model CategoriaFinanceira {
  id          String         @id @default(uuid())
  nome        String
  tipo        TipoLancamento
  grupo       String
  ativa       Boolean        @default(true)
  lancamentos Lancamento[]

  @@unique([nome, tipo])
}

model Lancamento {
  id             String              @id @default(uuid())
  tipo           TipoLancamento
  descricao      String
  valor          Int
  vencimento     DateTime
  competencia    DateTime
  status         StatusLancamento    @default(ABERTO)
  pagoEm         DateTime?
  valorPago      Int?
  formaPagamento String?
  documento      String?
  observacao     String?
  categoriaId    String
  categoria      CategoriaFinanceira @relation(fields: [categoriaId], references: [id])
  contaId        String?
  conta          ContaFinanceira?    @relation(fields: [contaId], references: [id])
  fornecedorId   String?
  fornecedor     Fornecedor?         @relation(fields: [fornecedorId], references: [id])
  funcionarioId  String?
  funcionario    Funcionario?        @relation(fields: [funcionarioId], references: [id])
  compraId       String?
  /// Contraparte livre (cliente, prestador)
  pessoa         String?
  grupoParcelas  String?
  parcela        Int?
  totalParcelas  Int?
  origem         String              @default("manual")
  criadoPor      String?
  criadoEm       DateTime            @default(now())

  @@index([status, vencimento])
  @@index([tipo, competencia])
}

// ─────────────────────────────── Funcionários (RH) ───────────────────────────────

model Funcionario {
  id               String                   @id @default(uuid())
  nome             String
  cpfCifrado       String?
  rg               String?
  nascimento       DateTime?
  telefone         String?
  email            String?
  endereco         String?
  cargo            String
  setor            String?
  tipoContrato     String                   @default("CLT")
  admissao         DateTime
  demissao         DateTime?
  salario          Int
  valeTransporte   Int                      @default(0)
  valeRefeicao     Int                      @default(0)
  outrosBeneficios Int                      @default(0)
  jornada          String?
  escala           String?
  crf              String?
  pixCifrado       String?
  /// Acesso ao sistema (se tiver login)
  usuarioId        String?                  @unique
  ativo            Boolean                  @default(true)
  observacoes      String?
  criadoEm         DateTime                 @default(now())
  ocorrencias      OcorrenciaFuncionario[]
  lancamentos      Lancamento[]
}

model OcorrenciaFuncionario {
  id            String      @id @default(uuid())
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  /// FERIAS | FALTA | ATESTADO | ADVERTENCIA | HORA_EXTRA | BONUS | DESCONTO | AFASTAMENTO | ADIANTAMENTO
  tipo          String
  inicio        DateTime
  fim           DateTime?
  valor         Int?
  descricao     String?
  criadoPor     String?
  criadoEm      DateTime    @default(now())

  @@index([funcionarioId, inicio])
}

// ─────────────── Crediário, convênios, orçamentos, inventário e cotação ───────────────

/// Empresa conveniada: os funcionários dela compram e a empresa paga (ou desconta em folha)
model Convenio {
  id                 String           @id @default(uuid())
  nome               String
  cnpj               String?
  contato            String?
  telefone           String?
  email              String?
  /// Desconto do convênio em pontos-base (500 = 5%)
  descontoBp         Int              @default(0)
  /// Dia do mês em que a fatura do convênio fecha
  diaFechamento      Int              @default(25)
  prazoPagamentoDias Int              @default(10)
  limitePadrao       Int              @default(30000)
  ativo              Boolean          @default(true)
  criadoEm           DateTime         @default(now())
  contas             ContaCrediario[]
}

/// Conta de crediário (fiado) de um cliente — própria ou de um conveniado
model ContaCrediario {
  id            String               @id @default(uuid())
  nome          String
  cpfHash       String?              @unique
  cpfFinal      String?
  telefone      String?
  usuarioId     String?
  convenioId    String?
  convenio      Convenio?            @relation(fields: [convenioId], references: [id])
  matricula     String?
  limite        Int
  /// Dia do mês em que as compras do crediário vencem
  diaVencimento Int                  @default(10)
  bloqueada     Boolean              @default(false)
  ativa         Boolean              @default(true)
  observacao    String?
  ultimaCobrancaEm DateTime?
  criadoEm      DateTime             @default(now())
  movimentos    MovimentoCrediario[]

  @@index([convenioId])
}

enum TipoMovCrediario {
  COMPRA
  PAGAMENTO
  ESTORNO
  AJUSTE
}

model MovimentoCrediario {
  id             String           @id @default(uuid())
  contaId        String
  conta          ContaCrediario   @relation(fields: [contaId], references: [id], onDelete: Cascade)
  tipo           TipoMovCrediario
  /// Positivo aumenta a dívida (compra); negativo reduz (pagamento/estorno)
  valor          Int
  descricao      String
  pedidoId       String?
  vencimento     DateTime?
  formaPagamento String?
  usuarioId      String?
  criadoEm       DateTime         @default(now())

  @@index([contaId, criadoEm])
}

enum TipoOrcamento {
  ORCAMENTO
  PRE_VENDA
}

enum StatusOrcamento {
  ABERTO
  CONVERTIDO
  CANCELADO
}

/// Orçamento para o cliente ou pré-venda montada no balcão para o caixa finalizar
model Orcamento {
  id           String          @id @default(uuid())
  numero       Int             @unique @default(autoincrement())
  tipo         TipoOrcamento   @default(PRE_VENDA)
  status       StatusOrcamento @default(ABERTO)
  lojaId       String
  vendedorId   String
  clienteNome  String?
  telefone     String?
  observacao   String?
  /// [{ produtoId, nome, quantidade, preco }]
  itens        Json
  total        Int
  validoAte    DateTime
  pedidoId     String?
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  @@index([lojaId, status])
}

enum StatusInventario {
  ABERTO
  FECHADO
  CANCELADO
}

/// Inventário (balanço): fotografa os lotes, recebe a contagem e acerta as diferenças
model Inventario {
  id           String           @id @default(uuid())
  numero       Int              @unique @default(autoincrement())
  lojaId       String
  descricao    String
  status       StatusInventario @default(ABERTO)
  criadoPorId  String
  fechadoPorId String?
  abertoEm     DateTime         @default(now())
  fechadoEm    DateTime?
  itens        InventarioItem[]

  @@index([lojaId, status])
}

model InventarioItem {
  id           String     @id @default(uuid())
  inventarioId String
  inventario   Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  produtoId    String
  loteId       String
  produtoNome  String
  loteCodigo   String
  validade     DateTime
  esperado     Int
  contado      Int?

  @@unique([inventarioId, loteId])
}

enum StatusCotacao {
  ABERTA
  FECHADA
  CANCELADA
}

/// Cotação de compra: mesmos itens com preço de vários fornecedores
model Cotacao {
  id          String        @id @default(uuid())
  numero      Int           @unique @default(autoincrement())
  lojaId      String
  descricao   String
  status      StatusCotacao @default(ABERTA)
  criadoPorId String
  criadoEm    DateTime      @default(now())
  fechadaEm   DateTime?
  itens       CotacaoItem[]
}

model CotacaoItem {
  id          String         @id @default(uuid())
  cotacaoId   String
  cotacao     Cotacao        @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  produtoId   String
  produtoNome String
  quantidade  Int
  precos      CotacaoPreco[]
}

model CotacaoPreco {
  id            String      @id @default(uuid())
  itemId        String
  item          CotacaoItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fornecedorId  String
  custoUnitario Int
  prazoDias     Int?

  @@unique([itemId, fornecedorId])
}
